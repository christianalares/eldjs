{
  "name": "@eldjs/core",
  "version": "0.2.0",
  "description": "Typed file-based APIs with Hono, Standard Schema, and TanStack routing conventions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianalares/eldjs.git",
    "directory": "packages/eldjs"
  },
  "homepage": "https://github.com/christianalares/eldjs#readme",
  "bugs": "https://github.com/christianalares/eldjs/issues",
  "keywords": [
    "hono",
    "api",
    "file-based-routing",
    "typescript",
    "standard-schema"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
