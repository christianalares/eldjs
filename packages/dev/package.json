{
  "name": "@eldjs/dev",
  "version": "0.1.0",
  "description": "Route generation, Vite integration, and CLI for Eld APIs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianalares/eldjs.git",
    "directory": "packages/dev"
  },
  "homepage": "https://github.com/christianalares/eldjs#readme",
  "bugs": "https://github.com/christianalares/eldjs/issues",
  "keywords": [
    "hono",
    "api",
    "file-based-routing",
    "vite",
    "codegen"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "eld": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@babel/types": "^7.29.8",
    "@tanstack/router-utils": "1.162.4",
    "@tanstack/virtual-file-routes": "1.162.0",
    "chokidar": "^4.0.3",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.21",
    "prettier": "^3.9.6",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@eldjs/core": "^0.1.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eldjs/core": "workspace:*",
    "@hono/vite-dev-server": "^0.25.3",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
