{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["src/routeTree.gen.ts"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "eldjs#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@eldjs/dev#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
